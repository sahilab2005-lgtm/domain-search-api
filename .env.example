
# .env itself should NEVER be committed — it's already in .gitignore.

# Whether MCP-backed search is enabled at all.
MCP_ENABLED=true

# Command used to launch the MCP server as a subprocess (over stdio).
# "python" resolves automatically to the interpreter running api.py.
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=["mcp_server.py"]
MCP_SERVER_ENV={}

# Name of the tool exposed by mcp_server.py.
MCP_SEARCH_TOOL_NAME=search
MCP_TIMEOUT_SECONDS=25

# Default number of results per query if the caller doesn't specify one.
MAX_RESULTS_DEFAULT=5

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=*


DOMAIN_CONFIG_PATH=config.json


LLM_MODEL=llama3.2:3b
LLM_NUM_CTX=0
